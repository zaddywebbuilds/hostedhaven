---
import BaseLayout from '../layouts/BaseLayout.astro';
import InteriorHero from '../components/InteriorHero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import OwnerCTA from '../components/OwnerCTA.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { services, serviceLabel, type Service } from '../data/services';
import { properties } from '../data/properties';
import { propertyImages, brandImage } from '../lib/images';
import { u, fixLinks, SITE } from '../lib/url';
import { business, ownerTestimonials, pricing } from '../data/business';

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug }, props: { s } }));
}
interface Props { s: Service }
const { s } = Astro.props;
const path = `/${s.slug}/`;
const imgs = propertyImages(s.heroProperty);
const isMain = s.slug === 'airbnb-management-san-antonio';
// The live co-hosting page used the house tour video and these two owner photos.
const introImgs = isMain ? [brandImage('happy-homeowners-outside-house'), brandImage('san-antonio-rental-home-exterior')] : [imgs[1], imgs[2]];
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Owners', path: '/airbnb-management-san-antonio/' }, { name: s.navLabel, path }];
if (s.slug === 'airbnb-management-san-antonio') crumbs.splice(1, 1);
// Real photos for each "What's handled" pillar: licensed stock where the scene is an activity,
// otherwise a real Hosted Havens interior (rotated across homes so no photo repeats on a page).
const stockFor: Record<string, string> = {
  message: 'owner-checking-phone', trending: 'revenue-analytics-laptop', chart: 'revenue-analytics-laptop', camera: 'listing-photography-tripod',
  broom: 'property-care-making-bed', eye: 'owner-checking-phone', calendar: 'extended-stay-suitcase', plane: 'extended-stay-suitcase',
};
const homeSlugs = ['de-soto-lighthouse', 'the-harding-place', 'la-maison-blount', 'coastal-run', 'halliday-fig-trees', 'grass-hollow'];
const usedStock = new Set<string>();
let homeTurn = 0;
const pillarImages = s.pillars.map((p) => {
  const stock = stockFor[p.icon];
  if (stock && !usedStock.has(stock)) { usedStock.add(stock); return { src: brandImage(stock), alt: `${p.title} for a San Antonio rental` }; }
  const slug = homeSlugs[(homeTurn + s.slug.length) % homeSlugs.length];
  const gallery = propertyImages(slug);
  const src = gallery[(2 + homeTurn * 3) % gallery.length];
  homeTurn++;
  return { src, alt: `Hosted Havens managed home in San Antonio — ${p.title.toLowerCase()}` };
});
const showcase = s.slug ==='mid-term-rental-management-san-antonio'
  ? properties.filter((p) => p.extendedStay).slice(0, 3)
  : null;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.navLabel,
    serviceType: 'Short-term rental co-hosting',
    description: s.metaDescription,
    url: `${SITE}${path}`,
    provider: { '@id': `${SITE}/#organization` },
    areaServed: business.serviceArea.map((c) => ({ '@type': 'City', name: `${c}, TX` })),
  },
];
---
<BaseLayout title={s.metaTitle} description={s.metaDescription} path={path} breadcrumbs={crumbs} schema={schema}>
  <InteriorHero
    eyebrow={s.eyebrow}
    title={s.h1}
    lead={s.lead}
    crumbs={crumbs}
    image={imgs[0]}
    video={isMain ? { src: '/videos/house-tour.mp4', poster: '/videos/house-tour-poster.webp' } : undefined}
    imageAlt={isMain ? 'Video tour of a Hosted Havens rental bedroom' : 'Interior of a Hosted Havens managed rental'}
    primary={{ label: 'Get My Property Analysis', href: '/property-analysis/', track: 'owner_analysis_start' }}
    secondary={{ label: 'Schedule a Property Tour', href: '/contact/#owners', track: 'property_tour_click' }}
    note="2-minute property form · No long-term contract required"
  >
    <Fragment slot="widget">
      {s.widget === 'revenue' && (<>
        <div class="fc-head"><span class="fc-title">Performance Strategy</span></div>
        <div class="fc-row">Smart pricing <b class="fc-up">Active</b></div>
        <div class="fc-row">Calendar gaps <b>Watching</b></div>
        <div class="fc-row">Market demand <b>Tracking</b></div>
      </>)}
      {s.widget === 'ops' && (<>
        <div class="fc-head"><span class="fc-title">Handled Today</span></div>
        <div class="fc-row"><span class="fc-time">10:00 AM</span>Turnover <b class="fc-ok">✓</b></div>
        <div class="fc-row"><span class="fc-time">3:00 PM</span>Guest arrival <b class="fc-ok">✓</b></div>
        <div class="fc-row"><span class="fc-time">7:42 PM</span>Question resolved <b class="fc-ok">✓</b></div>
      </>)}
      {s.widget === 'calendar' && (<>
        <div class="fc-head"><span class="fc-title">30+ Day Stay</span><span class="fc-label">Booked</span></div>
        <div class="fc-bars" aria-hidden="true">{[70, 70, 70, 70, 70, 70, 70, 70, 70, 70].map((h) => <i style={`height:${h}%`}></i>)}</div>
        <div class="fc-row">Mid-stay housekeeping <b class="fc-ok">✓</b></div>
      </>)}
      {s.widget === 'listing' && (<>
        <div class="fc-head"><span class="fc-title">Your Listing, Optimized</span></div>
        <div class="fc-row">Photography <b class="fc-up">↑</b></div>
        <div class="fc-row">Visibility <b class="fc-up">↑</b></div>
        <div class="fc-row">Guest questions <b class="fc-down">↓</b></div>
      </>)}
      {s.widget === 'care' && (<>
        <div class="fc-head"><span class="fc-title">Turnover Checklist</span></div>
        <div class="fc-row">Cleaning <b class="fc-ok">Confirmed ✓</b></div>
        <div class="fc-row">Inspection <b class="fc-ok">Complete ✓</b></div>
        <div class="fc-row">Restock <b class="fc-ok">Done ✓</b></div>
      </>)}
      {s.widget === 'launch' && (<>
        <div class="fc-head"><span class="fc-title">Launch Plan</span></div>
        <div class="fc-row">Assessment <b class="fc-ok">✓</b></div>
        <div class="fc-row">Photography <b class="fc-ok">✓</b></div>
        <div class="fc-row">Listing live <b>Next</b></div>
      </>)}
      {s.widget === 'cohost' && (<>
        <div class="fc-head"><span class="fc-title">Owner Access</span></div>
        <div class="fc-row">Calendar <b class="fc-ok">Visible ✓</b></div>
        <div class="fc-row">Hosting tools <b class="fc-ok">Shared ✓</b></div>
        <div class="fc-row">Contract <b>Flexible</b></div>
      </>)}
    </Fragment>
  </InteriorHero>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">Why it matters</span>
        <h2 set:html={s.intro.h2} />
        {s.intro.paragraphs.map((p) => <p class="lead" set:html={fixLinks(p)} />)}
        <a class="text-link" href={u('/property-analysis/')} data-track="owner_analysis_start">See what we’d change about your property <Icon name="arrow" /></a>
      </div>
      <div class="img-stack reveal reveal-d2">
        <div class="big"><Img src={introImgs[0]} alt={isMain ? 'Happy homeowners standing outside their house' : ''} sizes="(max-width: 1024px) 90vw, 45vw" /></div>
        <div class="small"><Img src={introImgs[1]} alt={isMain ? 'Exterior of a San Antonio rental home' : ''} sizes="(max-width: 1024px) 45vw, 22vw" /></div>
      </div>
    </div>
  </section>

  <section class="section bg-warm">
    <div class="container">
      <div class="section-head center reveal">
        <span class="eyebrow">What’s handled</span>
        <h2>Built around <em>your</em> property</h2>
      </div>
      <div class={`grid ${s.pillars.length === 4 ? 'grid-4' : 'grid-3'}`}>
        {s.pillars.map((p, i) => (
          <article class={`card3d svc-card handled-card reveal reveal-d${(i % 3) + 1}`}>
            <div class="svc-media">
              {pillarImages[i].src && <Img src={pillarImages[i].src} alt={pillarImages[i].alt} sizes="(max-width: 760px) 90vw, (max-width: 1024px) 45vw, 30vw" />}
              <span class="svc-shade"></span>
              <span class="handled-chip"><Icon name={p.icon} />{p.hook}</span>
            </div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">The detail</span>
        <h2>{s.detail.h2}</h2>
        {s.detail.paragraphs.map((p) => <p set:html={fixLinks(p)} />)}
        <div class="price-card" style="margin-top:2rem">
          <span class="price-sub">Published pricing</span>
          <div class="price-big">{pricing.managementFee}</div>
          <p class="muted" style="margin:.2rem 0 .8rem">{pricing.managementFeeUnit} · {pricing.setupFee} {pricing.setupFeeUnit}</p>
          <p class="small muted">{pricing.note}</p>
          <a class="text-link" href={u('/pricing/')}>How pricing works <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="card3d reveal reveal-d2">
        <h3 style="margin-top:0">Included in full-service support</h3>
        <ul class="ticks">{s.detail.bullets.map((b) => <li>{b}</li>)}</ul>
      </div>
    </div>
  </section>

  {s.steps && (
    <section class="section bg-cream">
      <div class="container">
        <div class="section-head center reveal">
          <span class="eyebrow">How it works</span>
          <h2>From property to <em>high-performing haven</em></h2>
        </div>
        <ol class="timeline" style="list-style:none">
          {s.steps.map((st, i) => (
            <li class={`t-step reveal reveal-d${(i % 4) + 1}`}>
              <span class="t-dot">{String(i + 1).padStart(2, '0')}</span>
              <div><h3>{st.title}</h3><p>{st.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {showcase && (
    <section class="section">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">In our portfolio</span>
          <h2>Homes set up for <em>longer stays</em></h2>
        </div>
        <div class="prop-grid">{showcase.map((p) => <PropertyCard p={p} />)}</div>
      </div>
    </section>
  )}

  <section class="section bg-warm">
    <div class="container split" style="align-items:start">
      <div class="reveal">
        <span class="eyebrow">Owner FAQ</span>
        <h2>Questions owners ask</h2>
        <p class="lead">Still deciding? A property analysis is free and there’s no obligation.</p>
        <blockquote class="mini-quote">
          <p>“{ownerTestimonials[0].quote}”</p>
          <cite>— {ownerTestimonials[0].name}, {ownerTestimonials[0].role}</cite>
        </blockquote>
        <div class="card3d" style="margin-top:1.2rem">
          <h3 style="margin-top:0">Related services</h3>
          <ul class="ticks">
            {s.related.map((r) => serviceLabel[r] && <li><a class="text-link" href={u(serviceLabel[r].href)}>{serviceLabel[r].label}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="reveal reveal-d2"><FAQ items={s.faqs} /></div>
    </div>
  </section>

  <OwnerCTA />
</BaseLayout>
