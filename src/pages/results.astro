    </div>
  </section>
  <script>
    (function () {
      const track = document.getElementById('owner-track') as HTMLElement | null;
      const dots = [...document.querySelectorAll<HTMLElement>('#owner-dots .slider-dot')];
      if (!track) return;
      function cardW(): number {
        const card = track!.querySelector<HTMLElement>('.review-card');
        if (!card) return 0;
        const gap = parseFloat(getComputedStyle(track!).gap) || 0;
        return card.offsetWidth + gap;
      }
      function curIdx(): number { return Math.round(track!.scrollLeft / (cardW() || 1)); }
      function goTo(idx: number): void {
        const total = track!.querySelectorAll('.review-card').length;
        idx = Math.max(0, Math.min(idx, total - 1));
        track!.scrollTo({ left: idx * cardW(), behavior: 'smooth' });
        dots.forEach((d, i) => d.classList.toggle('on', i === idx));
      }
      document.getElementById('owner-prev')?.addEventListener('click', () => goTo(curIdx() - 1));
      document.getElementById('owner-next')?.addEventListener('click', () => goTo(curIdx() + 1));
      dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
      let ticking = false;
      track.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => { const i = curIdx(); dots.forEach((d, j) => d.classList.toggle('on', j === i)); ticking = false; });
          ticking = true;
        }
      }, { passive: true });
      const total = () => track!.querySelectorAll('.review-card').length;
      let timer = setInterval(() => goTo((curIdx() + 1) % total()), 4800);
      const slider = document.getElementById('owner-slider');
      slider?.addEventListener('mouseenter', () => clearInterval(timer));
      slider?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo((curIdx() + 1) % total()), 4800); });
    })();
  </script>

  <section class="section bg-olive">
    <div class="container">
      <div class="section-head center reveal"><span class="eyebrow">What guests say</span><h2>Reviews from <em>real stays</em></h2></div>
      <div class=”grid grid-4”>
        {guestReviews.slice(0, 4).map((r, i) => (
          <figure class={`review-card reveal reveal-d${i + 1}`} style=”margin:0”>
            <div class=”stars” aria-label=”5 out of 5 stars”>★★★★★</div>
            <blockquote style=”margin:0”><p>”{r.quote}”</p></blockquote>
            <figcaption class=”review-by”><span class=”avatar-initial”>{r.name[0]}</span><span><strong>{r.name}</strong><small>{r.from}</small></span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <OwnerCTA title="See What We’d Change <em>About Your Property.</em>" />
</BaseLayout>
