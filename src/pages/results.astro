---
import BaseLayout from '../layouts/BaseLayout.astro';
import InteriorHero from '../components/InteriorHero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import OwnerCTA from '../components/OwnerCTA.astro';
import { propertyImages, coverImage } from '../lib/images';
import { u } from '../lib/url';
import { ownerTestimonials, guestReviews, businessStats, resultsDisclaimer } from '../data/business';
import { properties } from '../data/properties';

const verifiedStats = Object.values(businessStats).filter((s) => s.verified && s.value);

const showcases = [
  {
    slug: 'the-harding-place',
    title: 'The Harding Place',
    place: 'Craftsman home near Downtown San Antonio',
    challenge: 'A large, character-rich home needed to appeal to families and extended-stay guests without losing its vintage charm.',
    changes: ['Positioned around family travel and extended stays', 'Kids’ playroom and sleeping nook highlighted', 'Kitchen stocked for longer visits', 'Pet-friendly setup near the park'],
  },
  {
    slug: 's-park-1a',
    title: 'Collins Garden Studios',
    place: 'Eight-unit apartment building near downtown',
    challenge: 'Bland, sterile studios needed to become comfortable homes for guests staying 30 days or more.',
    changes: ['Design overhaul into bright, homey retreats', 'Fully equipped kitchenettes and remote-work Wi-Fi', 'Mix of pet-friendly and pet-free units', 'Set up for 30+ day stays near Lackland AFB'],
  },
  {
    slug: 'santa-anna-main',
    title: 'Santa Anna',
    place: 'Main house and guesthouse in Los Angeles Heights',
    challenge: 'A three-bedroom home and a separate one-bedroom casita sat on one lot, each competing for the same smaller bookings.',
    changes: ['Main house and guesthouse combined into a rare four-bedroom option for the area', 'Also bookable separately, so smaller groups still fit', 'Positioned against limited four-bedroom competition nearby', 'Minutes from the airport, the Pearl, and the Medical Center'],
  },
];
---
<BaseLayout
  title="Results & Property Showcases | Hosted Havens San Antonio"
  description="See how Hosted Havens positions and operates real San Antonio rentals, from Craftsman family homes to 30+ day studios near Lackland and rooms near Randolph AFB."
  path="/results/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Owner Results', path: '/results/' }]}
>
  <InteriorHero
    eyebrow="Results"
    title="Real Properties. <em>Real Operations.</em>"
    lead="A look at how Hosted Havens positions, prepares, and operates homes across San Antonio, and what we’d look at in yours."
    crumbs={[{ name: 'Home', path: '/' }, { name: 'Owner Results', path: '/results/' }]}
    image={coverImage('de-soto-lighthouse')}
    imageAlt="De Soto, a renovated Hosted Havens smart home in Universal City"
    primary={{ label: 'See If We’re a Good Fit', href: '/property-intake/', track: 'owner_analysis_start' }}
  />

  {verifiedStats.length > 0 && (
    <section class="section-tight">
      <div class="container">
        <div class="orbs">{verifiedStats.map((s) => <div class="orb reveal"><strong>{s.value}</strong><span>{s.label}</span></div>)}</div>
        <p class="footnote center">{resultsDisclaimer}</p>
      </div>
    </section>
  )}

  {showcases.map((sc, idx) => {
    const imgs = propertyImages(sc.slug);
    return (
      <section class={`section ${idx % 2 ? 'bg-warm' : ''}`}>
        <div class={`container split ${idx % 2 ? 'reverse' : ''}`}>
          <div class="img-stack reveal">
            <div class="big"><Img src={imgs[0]} alt={`${sc.title}, ${sc.place}`} sizes="(max-width: 1024px) 90vw, 45vw" /></div>
            <div class="small"><Img src={imgs[2]} alt={`${sc.title}, ${sc.place}`} sizes="(max-width: 1024px) 45vw, 22vw" /></div>
          </div>
          <div class="reveal reveal-d2">
            <span class="eyebrow">Property showcase</span>
            <h2>{sc.title}</h2>
            <p class="muted" style="margin-top:-.6rem">{sc.place}</p>
            <h3>The challenge</h3>
            <p>{sc.challenge}</p>
            <h3>What Hosted Havens focused on</h3>
            <ul class="ticks">{sc.changes.map((c) => <li>{c}</li>)}</ul>
            <a class="text-link" style="margin-top:1rem" href={u(`/stays/${sc.slug}/`)}>View the stay <Icon name="arrow" /></a>
          </div>
        </div>
      </section>
    );
  })}

  <section class="section">
    <div class="container">
      <div class="section-head center reveal"><span class="eyebrow">What property owners say</span><h2>From <em>real owners</em></h2></div>
      <div class="review-slider" id="owner-slider">
        <div class="review-track" id="owner-track">
          {ownerTestimonials.map((t) => (
            <figure class="review-card" style="margin:0">
              <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
              <blockquote style="margin:0"><p>"{t.quote}"</p></blockquote>
              <figcaption class="review-by"><span class="avatar-initial">{t.name[0]}</span><span><strong>{t.name}</strong><small>{t.role}</small></span></figcaption>
            </figure>
          ))}
        </div>
        <div class="slider-nav">
          <button class="slider-arrow prev" id="owner-prev" aria-label="Previous reviews"><Icon name="arrow" /></button>
          <div class="slider-dots" id="owner-dots">
            {ownerTestimonials.map((_, i) => (
              <button class={`slider-dot${i === 0 ? ' on' : ''}`} data-i={String(i)} aria-label={`Review ${i + 1}`}></button>
            ))}          </div>
          <button class="slider-arrow next" id="owner-next" aria-label="Next reviews"><Icon name="arrow" /></button>
        </div>
      </div>
