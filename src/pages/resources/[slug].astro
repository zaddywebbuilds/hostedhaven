---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import OwnerCTA from '../../components/OwnerCTA.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { articles, type Article } from '../../data/articles';
import { coverImage } from '../../lib/images';
import { u, fixLinks, SITE } from '../../lib/url';
import { business } from '../../data/business';

export async function getStaticPaths() {
  const cmsEntries = await getCollection('blog');
  const staticPaths = articles.map((a) => ({
    params: { slug: a.slug },
    props: { source: 'static' as const, a, entry: undefined },
  }));
  const cmsPaths = cmsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { source: 'cms' as const, a: undefined, entry },
  }));
  return [...staticPaths, ...cmsPaths];
}

interface Props {
  source: 'static' | 'cms';
  a: Article | undefined;
  entry: CollectionEntry<'blog'> | undefined;
}
const { source, entry } = Astro.props;

let a: Article;
let CmsContent: any = null;

if (source === 'cms' && entry) {
  const { Content } = await render(entry);
  CmsContent = Content;
  a = {
    slug: entry.id,
    title: entry.data.title,
    metaTitle: entry.data.metaTitle,
    description: entry.data.description,
    cluster: entry.data.cluster,
    published: entry.data.published,
    heroImage: entry.data.heroImage,
    cta: { label: entry.data.ctaLabel, href: entry.data.ctaHref },
    body: '',
  };
} else {
  a = Astro.props.a!;
}

const path = `/resources/${a.slug}/`;
const cover = a.heroProperty ? coverImage(a.heroProperty) : undefined;
const heroImgSrc = a.heroImage ?? (cover ? `/images/${cover.base}-1280.webp` : undefined);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Resources', path: '/resources/' }, { name: a.cluster, path: '/resources/' }, { name: a.title, path }];
const cmsEntries = await getCollection('blog');
const cmsPosts = cmsEntries.map((e) => ({
  slug: e.id, title: e.data.title, cluster: e.data.cluster, heroImage: e.data.heroImage,
  description: e.data.description, published: e.data.published,
  metaTitle: e.data.metaTitle, cta: { label: e.data.ctaLabel, href: e.data.ctaHref }, body: '',
}));
const allPosts = [...articles, ...cmsPosts];
const more = allPosts.filter((x) => x.slug !== a.slug).slice(0, 3);
const date = new Date(`${a.published}T12:00:00`).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });
const wordCount = a.body ? a.body.replace(/<[^>]+>/g, '').split(/\s+/).filter(Boolean).length : undefined;
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.title,
  description: a.description,
  datePublished: a.published,
  dateModified: a.published,
  wordCount: wordCount || undefined,
  mainEntityOfPage: `${SITE}${path}`,
  image: heroImgSrc ? `${SITE}${heroImgSrc}` : undefined,
  author: { '@type': 'Person', name: business.founder },
  publisher: { '@id': `${SITE}/#organization` },
}];
---
<BaseLayout title={a.metaTitle} description={a.description} path={path} breadcrumbs={crumbs} schema={schema} ogImage={heroImgSrc} ogType="article">
  <article>
    <section class="section-tight" style="padding-top:2.5rem">
      <div class="narrow">
        <nav aria-label="Breadcrumb"><ol class="breadcrumbs"><li><a href={u('/')}>Home</a></li><li><a href={u('/resources/')}>Resources</a></li><li><span aria-current="page">{a.cluster}</span></li></ol></nav>
        <span class="eyebrow">{a.cluster}</span>
        <h1 class="h1-interior">{a.title}</h1>
        <p class="lead">{a.description}</p>
        <p class="small muted">By {business.founder} · <time datetime={a.published}>{date}</time></p>
      </div>
      <div class="container" style="margin-top:2rem">
        <div style="border-radius:var(--r-xl);overflow:hidden;aspect-ratio:21/9;box-shadow:var(--shadow-deep)">
          {a.heroImage
            ? <img src={a.heroImage} alt={a.title} loading="eager" class="cover-fill" />
            : <Img src={cover} alt={a.title} eager sizes="(max-width: 1320px) 100vw, 1240px" class="cover-fill" />
          }
        </div>
      </div>
    </section>
    <section class="section-tight">
      <div class="narrow prose">
        {CmsContent ? <CmsContent /> : <Fragment set:html={fixLinks(a.body)} />}
      </div>
      <div class="narrow" style="margin-top:2rem">
        <div class="card3d" style="display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap">
          <div><span class="eyebrow" style="margin:0">Next step</span><h2 style="font-size:1.7rem;margin:.3rem 0 0">Put this into practice</h2></div>
          <div class="btn-row">
            <a class="btn btn-primary" href={u(a.cta.href)} data-track="owner_analysis_start">{a.cta.label} <Icon name="arrow" /></a>
            <a class="btn btn-glass" href={u('/property-intake/')}>Free Property Analysis</a>
          </div>
        </div>
      </div>
    </section>
  </article>

  <section class="section">
    <div class="container">
      <div class="section-head reveal"><span class="eyebrow">Keep reading</span><h2>More owner <em>resources</em></h2></div>
      <div class="grid grid-3">
        {more.map((m, i) => {
          const mc = (m as any).heroProperty ? coverImage((m as any).heroProperty) : undefined;
          return (
            <a class={`post-card reveal reveal-d${i + 1}`} href={u(`/resources/${m.slug}/`)}>
              <div class="post-media">
                {m.heroImage
                  ? <img src={m.heroImage} alt={m.title} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
                  : <Img src={mc} alt={m.title} sizes="(max-width: 760px) 100vw, 33vw" />
                }
              </div>
              <div class="post-body"><span class="pill">{m.cluster}</span><h3>{m.title}</h3></div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <OwnerCTA />
  <style>.cover-fill { width: 100%; height: 100%; object-fit: cover; }</style>
</BaseLayout>
