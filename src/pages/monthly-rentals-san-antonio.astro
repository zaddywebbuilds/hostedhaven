---
import GuestLanding from '../components/GuestLanding.astro';
import { properties } from '../data/properties';
const items = properties.filter((p) => p.extendedStay);
---
<GuestLanding
  path="/monthly-rentals-san-antonio/"
  metaTitle="Monthly Rentals San Antonio | Furnished Extended Stays | Hosted Havens"
  metaDescription="Furnished monthly rentals and extended stays in San Antonio for relocations, military moves, traveling professionals and remote workers. Book direct with Hosted Havens."
  crumb="Monthly Rentals"
  eyebrow="Guests · Extended stays"
  h1="Furnished Monthly Rentals in <em>San Antonio</em>"
  lead="Homes, studios and private rooms set up for weeks and months — with real kitchens, fast Wi-Fi, laundry and a local team when you need something."
  heroSlug="s-park-2b"
  heroAlt="A renovated Collins Garden studio near downtown San Antonio"
  items={items}
  introH2="Built for <em>living</em>, not just sleeping"
  intro={[
    'A longer stay needs more than a bed. These properties are stocked for everyday life — cooking, working, laundry and room to settle in — whether you’re relocating, on a PCS move, working a contract or between homes.',
    'Longer stays often include automatic discounts. Check each listing for its current rates and policies.',
  ]}
  points={[
    { icon: 'briefcase', title: 'Work-ready', text: 'Many stays include dedicated workspaces and high-speed internet.' },
    { icon: 'home', title: 'Fully equipped', text: 'Full or kitchenette cooking setups, linens, towels and household basics.' },
    { icon: 'pin', title: 'Across the metro', text: 'Near downtown, Lackland AFB, Randolph AFB, Live Oak and Universal City.' },
  ]}
  faqs={[
    { q: 'Do you offer discounts for monthly stays?', a: 'Some discounts are built in automatically for longer stays. Promo codes are also shared in the Hosted Havens Guest Lounge on Facebook.' },
    { q: 'Are these good for military PCS moves?', a: 'Yes. Several stays are close to Joint Base San Antonio locations, including private rooms about four minutes from Randolph AFB and studios roughly nine miles from Lackland AFB.' },
    { q: 'Is housekeeping included during long stays?', a: 'Some properties include mid-stay housekeeping. Check each listing for details.' },
    { q: 'How does check-in work for longer stays?', a: 'Check-in typically includes an online rental agreement, ID verification and a security hold, followed by arrival instructions.' },
  ]}
/>
