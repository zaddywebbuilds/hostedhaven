---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url';
import { links } from '../data/business';
---
<BaseLayout
  title="Property Analysis for San Antonio Rentals | Hosted Havens"
  description="Tell Hosted Havens about your San Antonio property and goals. We’ll review the home, location and rental setup to identify short-term rental opportunities."
  path="/property-analysis/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Property Analysis', path: '/property-analysis/' }]}
>
  <section class="ihero">
    <div class="stage">
      <div class="stage-arch" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      <div class="stage-glow a" aria-hidden="true"></div>
      <div class="stage-glow b" aria-hidden="true"></div>
      <div class="ihero-grid split-form">
        <div class="ihero-copy">
          <nav aria-label="Breadcrumb"><ol class="breadcrumbs"><li><a href={u('/')}>Home</a></li><li><span aria-current="page">Property Analysis</span></li></ol></nav>
          <span class="eyebrow">No obligation</span>
          <h1 class="h1-interior">Let’s See What Your <em>Property</em> Could Do.</h1>
          <p class="lead">Tell us a little about your home and your goals. Start with the property intake. Then schedule your property analysis tour when you are ready.</p>
          <ul class="ticks" style="margin:1.4rem 0">
            <li>Takes about 2–3 minutes</li>
            <li>Reviewed by a person on the Hosted Havens team</li>
            <li>Min contract 4–12 months if you move forward</li>
          </ul>
        </div>

        <div class="form-shell form-shell-embed" id="analysis">
          <iframe
            class="intake-embed"
            src={links.intakeSurvey}
            title="Hosted Havens co-hosting intake form"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          {/* Megan's approved wording, moved here from the old success screen. Her
              form shows its own confirmation on submit and sends owners to the
              co-hosting video, so this sets the expectation beforehand rather than
              competing with that as a second call to action. */}
          <p class="small muted" style="margin:.9rem 0 0">Once you send this through, the Hosted Havens team will review your intake form and contact you shortly.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-3">
      <div class="card3d reveal reveal-d1"><span class="icon-box"><Icon name="eye" /></span><h3>We review</h3><p>Your location, layout, condition, guest appeal, and any current listing performance.</p></div>
      <div class="card3d reveal reveal-d2"><span class="icon-box sage"><Icon name="compass" /></span><h3>We recommend</h3><p>Positioning, upgrades, and whether short, mid-term, or blended stays fit best.</p></div>
      <div class="card3d reveal reveal-d3"><span class="icon-box gold"><Icon name="file" /></span><h3>You decide</h3><p>A tailored proposal with published pricing and a 4–12 month minimum contract.</p></div>
    </div>
  </section>

</BaseLayout>
