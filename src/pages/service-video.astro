---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import OwnerCTA from '../components/OwnerCTA.astro';
import { u } from '../lib/url';
import { links, business } from '../data/business';

const videoId = 'ualldyV06lc';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Owners', path: '/airbnb-management-san-antonio/' }, { name: 'Service Video', path: '/service-video/' }];
---
<BaseLayout
  title="Service Video for San Antonio Owners | Hosted Havens"
  description="Watch a short message from Megan, founder of Hosted Havens, explaining how full-service co-hosting works for San Antonio property owners."
  path="/service-video/"
  breadcrumbs={crumbs}
>
  <section class="section-tight" style="padding-top:2rem">
    <div class="container narrow">
      <nav aria-label="Breadcrumb"><ol class="breadcrumbs">{crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={u(c.path)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol></nav>
      <span class="eyebrow">Owners · Service video</span>
      <h1 class="h1-interior">A Message From <em>Megan</em></h1>
      <p class="lead">Here is a special message from Megan, founder of Hosted Havens, to homeowners like you.</p>

      <div class="video-frame">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${videoId}?rel=0&playsinline=1`}
          title="Hosted Havens service video"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <p class="notice" style="margin-top:1.4rem">Revenue estimates, optimization plans, and upgrade ideas cannot be provided before the property analysis tour.</p>

      <div class="btn-row" style="margin-top:1.6rem">
        <a class="btn btn-primary" href={u('/property-analysis/')} data-track="owner_analysis_start">Submit Your Property Details <Icon name="arrow" /></a>
        <a class="btn btn-glass" href={links.calendlyAnalysisTour} target="_blank" rel="noopener noreferrer" data-track="calendly_click">Book a Property Analysis Tour</a>
      </div>

      <ul class="ticks" style="margin-top:1.6rem">
        <li><a class="text-link" href={u('/pricing/')}>How pricing works</a></li>
        <li><a class="text-link" href={u('/results/')}>Real properties we operate</a></li>
        <li><a class="text-link" href={`mailto:${business.ownerEmail}`} data-track="owner_email_click">Prefer to email? {business.ownerEmail}</a></li>
      </ul>
    </div>
  </section>

  <OwnerCTA />
  <style>
    .video-frame { position: relative; aspect-ratio: 16 / 9; margin-top: 1.6rem; border-radius: var(--r-lg); overflow: hidden; background: var(--peach); border: 1px solid #fff; box-shadow: var(--shadow-deep); }
    .video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  </style>
</BaseLayout>
