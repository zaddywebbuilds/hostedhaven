---
import BaseLayout from '../layouts/BaseLayout.astro';
import InteriorHero from '../components/InteriorHero.astro';
import Icon from '../components/Icon.astro';
import { coverImage } from '../lib/images';
import { u } from '../lib/url';
import { business, links, socials } from '../data/business';
---
<BaseLayout
  title="Contact Hosted Havens | San Antonio STR Co-Hosting & Stays"
  description="Contact Hosted Havens in San Antonio. Owners: get a property analysis or book a tour. Guests: get help with your stay by phone or email."
  path="/contact/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]}
  schema={[{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Hosted Havens' }]}
>
  <InteriorHero
    eyebrow="Contact"
    title="How Can We <em>Help?</em>"
    lead="Whether you own a property or you’re planning a stay, you’ll reach a local San Antonio team."
    crumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]}
    image={coverImage('halliday-fig-trees')}
    imageAlt="Halliday, a renovated Hosted Havens home near downtown San Antonio"
  />

  <section class="section">
    <div class="container grid grid-2">
      <article class="card3d reveal" id="owners" style="padding:clamp(1.8rem,4vw,3rem)">
        <span class="icon-box"><Icon name="home" /></span>
        <span class="eyebrow" style="margin-top:1.2rem">Property owners</span>
        <h2>Let’s Talk About <em>Your Property</em></h2>
        <p>Start with the property intake form. Then after watching our short service video, you can book a property analysis tour, which includes an onsite visit, extensive prep list, and a detailed analysis report with revenue projections for your property.</p>
        <div class="btn-row" style="margin:1.4rem 0">
          <a class="btn btn-primary" href={u("/property-analysis/")} data-track="owner_analysis_start">Submit Your Property Details <Icon name="arrow" /></a>
          <a class="btn btn-glass" href={links.calendlyAnalysisTour} target="_blank" rel="noopener noreferrer" data-track="calendly_click">Schedule a Property Tour</a>
        </div>
        <ul class="ticks">
          <li><a class="text-link" href={`mailto:${business.ownerEmail}`} data-track="owner_email_click">{business.ownerEmail}</a></li>
          <li><a class="text-link" href={`tel:${business.phone}`} data-track="phone_click">{business.displayPhone}</a></li>
        </ul>
      </article>

      <article class="card3d reveal reveal-d2" id="guests" style="padding:clamp(1.8rem,4vw,3rem)">
        <span class="icon-box sage"><Icon name="message" /></span>
        <span class="eyebrow" style="margin-top:1.2rem">Guests</span>
        <h2>Need Help With <em>a Stay?</em></h2>
        <p>Questions about a booking, check-in, or a specific home? Reach out and our guest services team will help.</p>
        <div class="btn-row" style="margin:1.4rem 0">
          <a class="btn btn-dark" href={`mailto:${business.guestEmail}`} data-track="guest_email_click"><Icon name="mail" /> {business.guestEmail}</a>
          <a class="btn btn-glass" href={`tel:${business.phone}`} data-track="phone_click"><Icon name="phone" /> Call</a>
        </div>
        <ul class="ticks">
          <li><a class="text-link" href={u('/stays/')}>Browse available stays</a></li>
          <li><a class="text-link" href={u('/why-book-direct/')}>Why book direct</a></li>
          <li><a class="text-link" href={links.guestLounge} target="_blank" rel="noopener noreferrer">Join the Hosted Havens Guest Lounge for promo codes</a></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band bg-warm reveal" style="border:1px solid #fff">
        <span class="eyebrow">Follow along</span>
        <h2>San Antonio Area <em>service area</em></h2>
        <p class="lead">Hosted Havens operates across Bexar County and surrounding communities: San Antonio, Converse, Live Oak, Universal City, Schertz, Leon Valley, and beyond.</p>
        <div class="btn-row">
          {socials.map((s) => <a class="btn btn-glass btn-sm" href={s.href} target="_blank" rel="noopener noreferrer"><Icon name={s.icon} /> {s.name}</a>)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
