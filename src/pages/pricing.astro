---
import BaseLayout from '../layouts/BaseLayout.astro';
import InteriorHero from '../components/InteriorHero.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import OwnerCTA from '../components/OwnerCTA.astro';
import { coverImage } from '../lib/images';
import { u } from '../lib/url';
import { pricing, links } from '../data/business';

const included = [
  ['Effortless onboarding', ['Customized property assessment and estimate', 'Tailored action plan from start to finish', 'Complimentary professional photography', 'Complete listing creation and optimization']],
  ['Dedicated owner support', ['Access to our support team 7 days a week', 'Transparent access to professional hosting tools', 'Real-time calendar visibility', 'Flexible service with no long-term contract']],
  ['Price optimization', ['Dynamic smart pricing', 'Revenue strategies tailored to your property', 'Calendar optimized for peak booking times', 'Real-time adjustments based on market trends', 'Clear insights into pricing performance']],
  ['Comprehensive home care', ['Custom home guidebook for guests', 'Professional cleaning after each stay', 'Tax collection and remittance support', 'Routine inspections and proactive maintenance', 'Low-inventory alerts and restocking']],
] as const;

const faqs = [
  { q: 'What does the property tour cost, and what do I get?', a: `The property tour is ${pricing.tourFee}. ${pricing.tourIncludes} It follows the property form and a short overview video, so you already know how we work before you book.` },
  { q: 'What does the management fee cover?', a: 'The ongoing fee covers full-service co-hosting: guest communication, pricing, listing management, owner support and coordination of cleaning, inspections and maintenance. Your custom proposal spells out the exact scope.' },
  { q: 'Why is the fee a range?', a: 'Property type, size, condition, location and the services you need all affect the work involved. Your final rate is confirmed in a custom proposal.' },
  { q: 'What is the setup fee for?', a: 'The one-time listing setup fee covers onboarding work such as the property assessment, action plan, photography coordination and listing creation.' },
  { q: 'Are cleaning costs included?', a: 'Cleaning after each stay is coordinated as part of the service. How cleaning costs are charged is outlined in your proposal.' },
  { q: 'Is there a long-term contract?', a: 'No. Hosted Havens offers flexible service with no long-term contract.' },
];
---
<BaseLayout
  title="Airbnb Co-Hosting Pricing San Antonio | Hosted Havens"
  description="Transparent Airbnb co-hosting pricing in San Antonio: a $150 property tour with analysis report, typically 18%–22% per booking and a one-time $150–$500 listing setup fee."
  path="/pricing/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Owners', path: '/airbnb-management-san-antonio/' }, { name: 'Pricing', path: '/pricing/' }]}
>
  <InteriorHero
    eyebrow="Owners · Transparent pricing"
    title="Straightforward Pricing for <em>Full-Service</em> Co-Hosting"
    lead="No hidden tiers and no long-term lock-in. A paid property tour with a detailed analysis report, a published fee range, a one-time setup fee and a custom proposal that confirms exactly what’s included for your property."
    crumbs={[{ name: 'Home', path: '/' }, { name: 'Owners', path: '/airbnb-management-san-antonio/' }, { name: 'Pricing', path: '/pricing/' }]}
    image={coverImage('halliday-fig-trees')}
    imageAlt="Dining room at Halliday, a renovated Hosted Havens home near downtown San Antonio"
    primary={{ label: 'Request a Custom Proposal', href: '/property-analysis/', track: 'owner_analysis_start' }}
    secondary={{ label: `Book a Property Tour · ${pricing.tourFee}`, href: '/contact/#owners', track: 'property_tour_click' }}
  >
    <Fragment slot="widget">
      <div class="fc-head"><span class="fc-title">Management Fee</span></div>
      <div class="price-big" style="font-size:2.6rem">{pricing.managementFee}</div>
      <div class="fc-row">{pricing.managementFeeUnit}</div>
      <div class="fc-row">Setup <b>{pricing.setupFee}</b></div>
    </Fragment>
  </InteriorHero>

  <section class="section">
    <div class="container grid grid-2">
      <div class="price-card reveal">
        <span class="price-sub">Ongoing management</span>
        <div class="price-big">{pricing.managementFee}</div>
        <p class="lead" style="margin:.4rem 0 1rem">{pricing.managementFeeUnit}, typical range</p>
        <p class="muted">Full-service co-hosting: guests, pricing, listing, owner support and property care coordination.</p>
      </div>
      <div class="price-card reveal reveal-d2" style="background:linear-gradient(160deg,#fff,#F0EEE3)">
        <span class="price-sub">One-time setup</span>
        <div class="price-big" style="color:#656134">{pricing.setupFee}</div>
        <p class="lead" style="margin:.4rem 0 1rem">listing setup fee</p>
        <p class="muted">Assessment, action plan, photography coordination and complete listing creation.</p>
      </div>
    </div>
    <div class="narrow"><p class="notice" style="margin-top:1.6rem;text-align:center">{pricing.note}</p></div>
  </section>

  <section class="section bg-warm">
    <div class="container">
      <div class="section-head center reveal"><span class="eyebrow">What’s included</span><h2>Everything behind the <em>fee</em></h2></div>
      <div class="grid grid-4">
        {included.map(([title, items], i) => (
          <article class={`card3d reveal reveal-d${i + 1}`}>
            <span class={`icon-box ${i % 3 === 1 ? 'sage' : i % 3 === 2 ? 'gold' : ''}`}><Icon name={['layers', 'eye', 'trending', 'broom'][i]} /></span>
            <h3>{title}</h3>
            <ul class="ticks">{items.map((it) => <li>{it}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split" style="align-items:start">
      <div class="reveal">
        <span class="eyebrow">Pricing FAQ</span>
        <h2>Questions about <em>cost</em></h2>
        <p class="lead">Want exact numbers for your home? A custom proposal follows your property analysis.</p>
        <div class="btn-row"><a class="btn btn-primary" href={u('/property-analysis/')} data-track="owner_analysis_start">Request a Custom Proposal <Icon name="arrow" /></a>
        <a class="btn btn-glass" href={links.calendlyAnalysisTour} target="_blank" rel="noopener noreferrer" data-track="calendly_click">Book a Tour</a></div>
      </div>
      <div class="reveal reveal-d2"><FAQ items={faqs} /></div>
    </div>
  </section>

  <OwnerCTA />
</BaseLayout>
