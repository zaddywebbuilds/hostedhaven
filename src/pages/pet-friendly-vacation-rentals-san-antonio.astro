---
import GuestLanding from '../components/GuestLanding.astro';
import { properties } from '../data/properties';
const items = properties.filter((p) => p.petFriendly);
---
<GuestLanding
  path="/pet-friendly-vacation-rentals-san-antonio/"
  metaTitle="Pet-Friendly Vacation Rentals San Antonio | Hosted Havens"
  metaDescription="Pet-friendly vacation rentals in San Antonio with fenced yards, nearby parks, and room for the whole family. Book direct with Hosted Havens."
  crumb="Pet-Friendly Stays"
  eyebrow="Guests · Pets welcome"
  h1="Pet-Friendly Vacation Rentals in <em>San Antonio</em>"
  lead="Bring the whole family, fur included. Homes with fenced yards, studios facing the park, and stays close to green space across San Antonio and Live Oak."
  heroSlug="halliday-fig-trees"
  heroAlt="Halliday, a pet-friendly Hosted Havens home with a fenced yard near downtown San Antonio"
  items={items}
  introH2="Room for <em>everyone</em> on the trip"
  intro={[
    'Leaving a pet behind can make a trip harder than it needs to be. These Hosted Havens stays welcome pets, many with fenced yards, or parks just steps away.',
    'Pet rules, such as the number of pets allowed and any pet fees, vary by property, so review each listing before you book.',
  ]}
  points={[
    { icon: 'paw', title: 'Fenced yards', text: 'Several homes have private fenced yards for play and fresh air.' },
    { icon: 'sun', title: 'Parks nearby', text: 'Collins Garden Park, Live Oak Park, and parks across from The Harding Place.' },
    { icon: 'users', title: 'Family sized', text: 'From studios for two to homes sleeping ten.' },
  ]}
  faqs={[
    { q: 'How many pets can I bring?', a: 'It depends on the property. For example, La Maison Blount welcomes up to three pets. Check each listing’s pet policy before booking.' },
    { q: 'Are all Hosted Havens stays pet friendly?', a: 'No. Some studios and rooms are intentionally pet-free for guests with allergies. Use the Pet Friendly filter on the <a href="/stays/">stays page</a>.' },
    { q: 'Are there pet fees?', a: 'Pet fees and rules, when applicable, are shown at booking for each property.' },
  ]}
/>
