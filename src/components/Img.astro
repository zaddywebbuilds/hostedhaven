---
import { u } from '../lib/url';
import type { ImgEntry } from '../lib/images';

interface Props {
  src?: ImgEntry;
  alt: string;
  sizes?: string;
  eager?: boolean;
  lazy?: boolean;
  class?: string;
}
const { src, alt, sizes = '(max-width: 760px) 100vw, 50vw', eager = false, lazy = !eager, class: cls } = Astro.props;
const widths = src?.widths ?? [];
const largest = widths[widths.length - 1];
const srcset = src ? widths.map((w) => `${u(`/images/${src.base}-${w}.webp`)} ${w}w`).join(', ') : '';
---
{src && (
  <img
    src={u(`/images/${src.base}-${largest}.webp`)}
    srcset={srcset}
    sizes={sizes}
    alt={alt}
    width={largest}
    height={Math.round(largest * src.ratio)}
    loading={lazy ? 'lazy' : 'eager'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : undefined}
    class={cls}
  />
)}
