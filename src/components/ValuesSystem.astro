    .c1 .vs-photo { min-height: 0; aspect-ratio: 4 / 5; }
    .s-care .vs-photo { min-height: 380px; }
    .vs-card { border-radius: 28px; transform: none !important; }
    .vs-copy p { font-size: .95rem; }
    .vs-join { flex-direction: column; align-items: flex-start; padding-right: clamp(1.4rem, 3vw, 2.4rem); }
    .vs-join-img { display: none; }
  }
  @media (max-width: 420px) {
    .ui-timeline li { grid-template-columns: 3.6rem 1fr; }
    .s-quality .vs-front, .s-pricing .vs-front { margin-inline: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vs-cell, .vs-card, .vs-front, .vs-photo, .vs-photo :global(img), .step, .swap > span, .ui-checks i, .ui-stars i, .rail, .ring .fill, .spark .line, .vs-index, .vs-index circle { transition: none !important; }
    .vs-card { transform: none !important; }
    :global(.js) .vs-cell { opacity: 1; transform: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cells = document.querySelectorAll<HTMLElement>('.vs-cell');
  const cards = document.querySelectorAll<HTMLElement>('[data-vs]');

  if (reduce || !('IntersectionObserver' in window)) {
    cells.forEach((c) => c.classList.add('is-in'));
    cards.forEach((c) => c.classList.add('is-playing'));
  } else {
    // Entrance: once per cell.
    const enter = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); enter.unobserve(en.target); } });
    }, { rootMargin: '0px 0px -8% 0px' });
    cells.forEach((c) => enter.observe(c));

    // Scene sequence: plays once, when the card is reasonably visible.
    const play = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-playing'); play.unobserve(en.target); } });
    }, { threshold: 0.4 });
    cards.forEach((c) => play.observe(c));
    // Never leave a scene unplayed if the observer misses (e.g. very tall card on a short viewport).
    window.setTimeout(() => cards.forEach((c) => { const r = c.getBoundingClientRect(); if (r.top < innerHeight && r.bottom > 0) c.classList.add('is-playing'); }), 3000);

    // Ambient aura drifts ~20px with scroll while the section is on screen.
    const section = document.querySelector<HTMLElement>('.vs');
    const aura = section?.querySelector<HTMLElement>('.vs-aura');
    if (section && aura) {
      let ticking = false;
      const drift = () => {
        ticking = false;
        const r = section.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight) return;
        const p = (innerHeight - r.top) / (innerHeight + r.height);
        aura.style.setProperty('--aura-y', `${((p - 0.5) * 40).toFixed(1)}px`);
      };
      window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(drift); } }, { passive: true });
      drift();
    }

    // Desktop pointer depth: ±1.5° / ±2°, front UI follows at a fraction of the pointer.
    const fine = window.matchMedia('(pointer: fine) and (min-width: 1025px)');
    if (fine.matches) {
      cards.forEach((card) => {
        let frame = 0;
        let px = 0.5;
        let py = 0.5;
        const apply = () => {
          frame = 0;
          const x = px - 0.5;
          const y = py - 0.5;
          card.style.setProperty('--ry', `${(x * 4).toFixed(2)}deg`);
          card.style.setProperty('--rx', `${(-y * 3).toFixed(2)}deg`);
          card.style.setProperty('--fx', `${(x * 10).toFixed(1)}px`);
          card.style.setProperty('--fy', `${(y * 8).toFixed(1)}px`);
          card.style.setProperty('--mx', `${(px * 100).toFixed(0)}%`);
          card.style.setProperty('--my', `${(py * 100).toFixed(0)}%`);
        };
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          px = (e.clientX - r.left) / r.width;
          py = (e.clientY - r.top) / r.height;
          if (!frame) frame = requestAnimationFrame(apply);
        });
        card.addEventListener('pointerleave', () => {
          if (frame) cancelAnimationFrame(frame);
          frame = 0;
          ['--rx', '--ry', '--fx', '--fy', '--mx', '--my'].forEach((p) => card.style.removeProperty(p));
        });
      });
    }
  }
</script>
