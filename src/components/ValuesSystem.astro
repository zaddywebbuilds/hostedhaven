---
// About page · "How we work" — each value is shown as a small operational scene.
// All scene UI is illustrative (no real guests, owners, reviews or revenue) and is aria-hidden;
// the value titles and descriptions stay as real, readable HTML.
import Img from './Img.astro';
import { propertyImages } from '../lib/images';
import { values, business } from '../data/business';

const pick = (slug: string, i: number) => { const g = propertyImages(slug); return g[Math.min(i, g.length - 1)]; };
const arrivalImg = pick('coastal-run', 6);        // smart-lock front door
const turnoverImg = pick('de-soto-lighthouse', 26); // freshly made bed
const warmImg = pick('la-maison-blount', 0);      // living room
const updateImg = pick('the-harding-place', 1);   // home exterior
const joinImg = pick('halliday-fig-trees', 8);    // living room
const pricingImg = pick('halliday-fig-trees', 0); // dining room set for guests

const checklist = ['Fresh linens', 'Kitchen reset', 'Bathroom inspection', 'Amenities restocked', 'Photo verification'];
const week = [
  { d: 'Mon', o: 142 }, { d: 'Tue', o: 142 }, { d: 'Wed', o: 149 }, { d: 'Thu', o: 159 },
  { d: 'Fri', o: 189, n: 204 }, { d: 'Sat', o: 207, n: 229 }, { d: 'Sun', o: 176, n: 184 },
];
const timeline = [
  ['10:30 AM', 'Turnover started'], ['12:05 PM', 'Maintenance note identified'], ['12:18 PM', 'Owner notified'],
  ['1:40 PM', 'Repair completed'], ['2:10 PM', 'Final inspection passed'],
];
const idx = (n: number) => String(n).padStart(2, '0');
---
<section class="section vs" data-toast-safe aria-labelledby="vs-title">
  <div class="vs-aura" aria-hidden="true"></div>
  <div class="container">
    <div class="section-head vs-head reveal">
      <span class="eyebrow">Our values</span>
      <h2 id="vs-title">How we <em>work</em></h2>
    </div>

    <div class="vs-grid">
      <!-- 01 · Hospitality First -->
      <div class="vs-cell c1" style="--i:0">
        <article class="vs-card" data-vs>
          <div class="vs-light" aria-hidden="true"></div>
          <div class="vs-copy">
            <span class="vs-index" aria-hidden="true"><svg viewBox="0 0 56 56"><circle cx="28" cy="28" r="26" /></svg><b>{idx(1)}</b></span>
            <h3>{values[0].title}</h3>
            <p>{values[0].text}</p>
          </div>
          <div class="vs-scene s-arrival" aria-hidden="true">
            <div class="vs-photo">{arrivalImg && <Img src={arrivalImg} alt="" sizes="(max-width: 760px) 92vw, 46vw" />}</div>
            <div class="vs-front">
              <div class="ui-chip ui-lock">
                <span class="swap ico"><span class="a"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg></span><span class="b ok"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4L19 7" /></svg></span></span>
                <span class="swap txt"><span class="a">Locked</span><span class="b">Welcome</span></span>
                <em>3:02 PM · Guest checked in</em>
              </div>
              <div class="ui-panel ui-thread">
                <div class="ui-top"><span class="dot"></span>A typical arrival</div>
                <div class="bub in step" style="--d:900ms">We’re in — the place is beautiful. Thank you!</div>
                <div class="bub out step" style="--d:1550ms">Welcome! Enjoy your stay. We’re here if you need anything.</div>
                <div class="ui-stars step" style="--d:2150ms"><span>Guest experience</span><b>{[0, 1, 2, 3, 4].map((s) => <i style={`--s:${2200 + s * 90}ms`}>★</i>)}</b></div>
              </div>
            </div>
          </div>
        </article>
      </div>

      <!-- 02 · Quality Over Shortcuts -->
      <div class="vs-cell c2" style="--i:1">
        <article class="vs-card" data-vs>
          <div class="vs-light" aria-hidden="true"></div>
          <div class="vs-copy">
            <span class="vs-index" aria-hidden="true"><svg viewBox="0 0 56 56"><circle cx="28" cy="28" r="26" /></svg><b>{idx(2)}</b></span>
            <h3>{values[1].title}</h3>
            <p>{values[1].text}</p>
          </div>
          <div class="vs-scene s-quality" aria-hidden="true">
            <div class="vs-photo short">{turnoverImg && <Img src={turnoverImg} alt="" sizes="(max-width: 760px) 92vw, 26vw" />}</div>
            <div class="vs-front ui-panel">
              <div class="ui-top">
                <svg class="ring" viewBox="0 0 36 36"><circle class="track" cx="18" cy="18" r="15" /><circle class="fill" cx="18" cy="18" r="15" /></svg>
                Turnover quality check
                <span class="swap state"><span class="a">In progress</span><span class="b">Guest-ready ✓</span></span>
              </div>
              <ul class="ui-checks">
                {checklist.map((t, i) => <li class="step" style={`--d:${300 + i * 360}ms`}><span>{t}</span><i><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4L19 7" /></svg></i></li>)}
              </ul>
              <div class="ui-foot">Guest-ready · 2:18 PM</div>
            </div>
          </div>
        </article>
      </div>

      <!-- 03 · Adapt Quickly -->
      <div class="vs-cell c3" style="--i:2">
        <article class="vs-card" data-vs>
          <div class="vs-light" aria-hidden="true"></div>
          <div class="vs-copy">
            <span class="vs-index" aria-hidden="true"><svg viewBox="0 0 56 56"><circle cx="28" cy="28" r="26" /></svg><b>{idx(3)}</b></span>
            <h3>{values[2].title}</h3>
            <p>{values[2].text}</p>
          </div>
          <div class="vs-scene s-pricing" aria-hidden="true">
            <div class="vs-photo short">{pricingImg && <Img src={pricingImg} alt="" sizes="(max-width: 760px) 92vw, 26vw" />}</div>
            <div class="vs-front ui-panel">
              <div class="ui-top">Nightly rates <span class="tag">Illustrative pricing</span></div>
              <div class="spark">
                <svg viewBox="0 0 280 60" preserveAspectRatio="none">
                  <path class="area" d="M0 50 C30 49 50 48 80 46 S130 40 160 34 S200 10 220 8 S260 22 280 24 L280 60 L0 60Z" />
                  <path class="line" pathLength="1" d="M0 50 C30 49 50 48 80 46 S130 40 160 34 S200 10 220 8 S260 22 280 24" />
                </svg>
                <span class="demand step" style="--d:1250ms">Weekend demand ↑</span>
              </div>
              <div class="rates">
                {week.map((w, i) => (
                  <div class={`rate${w.n ? ' up' : ''}`} style={w.n ? `--d:${1700 + (i - 4) * 160}ms` : ''}>
                    <span class="day">{w.d}</span>
                    {w.n ? <span class="swap val"><span class="a">${w.o}</span><span class="b">${w.n}</span></span> : <span class="val">${w.o}</span>}
                  </div>
                ))}
              </div>
              <div class="ui-foot split">
                <span class="chips"><i>Event demand</i><i>Booking window</i><i>Calendar gaps</i></span>
                <span class="done step" style="--d:2400ms">Pricing adjusted ✓</span>
              </div>
            </div>
          </div>
        </article>
      </div>

      <!-- 04 · Lead With Empathy -->
      <div class="vs-cell c4 wide" style="--i:3">
        <article class="vs-card" data-vs>
          <div class="vs-light" aria-hidden="true"></div>
          <div class="vs-copy">
            <span class="vs-index" aria-hidden="true"><svg viewBox="0 0 56 56"><circle cx="28" cy="28" r="26" /></svg><b>{idx(4)}</b></span>
            <h3>{values[3].title}</h3>
            <p>{values[3].text}</p>
          </div>
          <div class="vs-scene s-care" aria-hidden="true">
            <div class="vs-photo">{warmImg && <Img src={warmImg} alt="" sizes="(max-width: 760px) 92vw, 30vw" />}</div>
            <div class="vs-front ui-panel">
              <div class="ui-top"><span class="dot warm"></span>Guest message <em>during a stay</em></div>
              <div class="bub in step" style="--d:200ms">Hi! The house feels a little warm. Could someone take a look?</div>
              <div class="bub out step" style="--d:850ms">Absolutely — thanks for letting us know. We’re checking it now.</div>
              <ul class="ui-checks compact">
                {['Maintenance contacted', 'Owner updated', 'Guest follow-up'].map((t, i) => <li class="step" style={`--d:${1500 + i * 340}ms`}><span>{t}</span><i><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4L19 7" /></svg></i></li>)}
              </ul>
              <span class="resolved" style="--d:2650ms">Resolved · Guest updated</span>
            </div>
          </div>
        </article>
      </div>

      <!-- 05 · Clear, Honest Communication -->
      <div class="vs-cell c5 wide" style="--i:4">
        <article class="vs-card" data-vs>
          <div class="vs-light" aria-hidden="true"></div>
          <div class="vs-copy">
            <span class="vs-index" aria-hidden="true"><svg viewBox="0 0 56 56"><circle cx="28" cy="28" r="26" /></svg><b>{idx(5)}</b></span>
            <h3>{values[4].title}</h3>
            <p>{values[4].text}</p>
          </div>
          <div class="vs-scene s-update" aria-hidden="true">
            <div class="vs-front ui-panel">
              <div class="ui-top">
                <span class="thumb">{updateImg && <Img src={updateImg} alt="" sizes="44px" />}</span>
                <span class="ttl">Property update<small>Sent to owner · today</small></span>
              </div>
              <ol class="ui-timeline">
                <span class="rail"></span>
                {timeline.map(([t, label], i) => <li class="step" style={`--d:${300 + i * 300}ms`}><time>{t}</time><span>{label}</span></li>)}
              </ol>
              <div class="ui-foot split">
                <span class="note step" style="--d:2000ms">Nothing hidden. Nothing left unexplained.</span>
                <span class="more">View details →</span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>

    <aside class="vs-join reveal" aria-labelledby="vs-join-title">
      <div class="vs-join-copy">
        <span class="eyebrow">Join the team</span>
        <h3 id="vs-join-title">Driven, resilient and quality-focused?</h3>
        <p>Hosted Havens (formerly Expat Property Tours) is growing. If hospitality, attention to detail and solving problems sound like you, send your resume and qualifications.</p>
      </div>
      <a class="btn btn-dark" href={`mailto:${business.guestEmail}?subject=Joining%20the%20Hosted%20Havens%20team`}>Email Your Resume <span aria-hidden="true">→</span></a>
      <div class="vs-join-img" aria-hidden="true">{joinImg && <Img src={joinImg} alt="" sizes="360px" />}</div>
    </aside>
  </div>
</section>

<style>
  .vs { position: relative; overflow: clip; }
  .vs-aura { position: absolute; left: 50%; top: 18%; width: min(1100px, 120vw); aspect-ratio: 1.6; margin-left: calc(min(1100px, 120vw) / -2); background: radial-gradient(closest-side, rgba(255, 140, 114, .22), rgba(248, 212, 187, .16) 55%, transparent 75%); transform: translate3d(0, var(--aura-y, 0px), 0); pointer-events: none; z-index: 0; }
  .vs .container { position: relative; z-index: 1; }
  .vs-head { margin-bottom: clamp(2rem, 4vw, 3.2rem); }

  /* Bento */
  .vs-grid { display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); gap: clamp(1rem, 1.8vw, 1.5rem); }
  .c1 { grid-column: span 6; } .c2, .c3 { grid-column: span 4; } .wide { grid-column: span 7; }
  .c2 .vs-card, .c3 .vs-card { padding: 1.5rem; }

  /* Entrance (outer cell) — card tilt lives on the inner card so the transforms never fight */
  .vs-cell { display: flex; }
  :global(.js) .vs-cell { opacity: 0; transform: translate3d(0, 24px, 0) scale(.985); transition: opacity .8s cubic-bezier(.22, 1, .36, 1), transform .85s cubic-bezier(.22, 1, .36, 1); transition-delay: calc(var(--i) * 80ms); }
  :global(.js) .vs-cell.is-in, :global(.js.reveal-ready) .vs-cell { opacity: 1; transform: none; }

  /* Card: back plane (light) · middle (copy) · front (scene UI) */
  .vs-card {
    --rx: 0deg; --ry: 0deg; --fx: 0px; --fy: 0px; --lift: 0px; --mx: 30%; --my: 0%;
    position: relative; flex: 1; display: flex; flex-direction: column; gap: 1.4rem;
    padding: clamp(1.4rem, 2.2vw, 2rem); border-radius: 32px; isolation: isolate;
    background: linear-gradient(160deg, rgba(255, 255, 255, .72), rgba(255, 244, 236, .5));
    border: 1px solid rgba(255, 255, 255, .8);
    box-shadow: 0 1px 0 rgba(255, 255, 255, .9) inset, 0 20px 45px rgba(112, 70, 48, .10), 0 40px 90px rgba(145, 88, 56, .08);
    transform: perspective(1200px) translate3d(0, var(--lift), 0) rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: transform .6s cubic-bezier(.22, 1, .36, 1), box-shadow .6s cubic-bezier(.22, 1, .36, 1);
  }
  .vs-light { position: absolute; inset: 0; border-radius: inherit; z-index: -1; pointer-events: none; background: radial-gradient(520px circle at var(--mx) var(--my), rgba(255, 214, 196, .55), transparent 60%); }
  .vs-card:hover { --lift: -4px; box-shadow: 0 1px 0 rgba(255, 255, 255, .9) inset, 0 26px 55px rgba(112, 70, 48, .14), 0 50px 110px rgba(145, 88, 56, .11); }

  .vs-copy h3 { margin: 1rem 0 .45rem; font-size: clamp(1.55rem, 2vw, 1.9rem); line-height: 1.1; text-wrap: balance; }
  .vs-copy p { margin: 0; font-size: 1rem; line-height: 1.6; color: var(--ink-soft); max-width: 42ch; }

  /* Index disc */
  .vs-index { position: relative; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fff, rgba(255, 236, 226, .85)); box-shadow: 0 1px 0 #fff inset, 0 10px 24px rgba(229, 102, 74, .16), 0 0 0 6px rgba(255, 255, 255, .35); transform: translateZ(20px); transition: transform .7s cubic-bezier(.22, 1, .36, 1) .15s; }
  .vs-index b { font-family: var(--serif); font-size: 1.15rem; font-weight: 600; color: var(--coral-deep); }
  .vs-index svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
  .vs-index circle { fill: none; stroke: rgba(229, 102, 74, .45); stroke-width: 1.2; stroke-dasharray: 164; stroke-dashoffset: 0; transition: stroke-dashoffset 1.1s cubic-bezier(.22, 1, .36, 1) .2s; }

  /* Scene */
  .vs-scene { position: relative; margin-top: auto; }
  .vs-photo { position: relative; border-radius: 22px; overflow: hidden; aspect-ratio: 16 / 10; box-shadow: 0 14px 30px rgba(80, 50, 35, .16); transition: transform .9s cubic-bezier(.22, 1, .36, 1); }
  .vs-photo.short { aspect-ratio: 16 / 8; }
  .vs-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s cubic-bezier(.22, 1, .36, 1); }
  .vs-card:hover .vs-photo :global(img) { transform: scale(1.02); }
  .vs-front { position: relative; transform: translate3d(var(--fx), var(--fy), 0); transition: transform .6s cubic-bezier(.22, 1, .36, 1); }
  .vs-card:hover .vs-front { transform: translate3d(var(--fx), calc(var(--fy) - 4px), 0); }

  /* Shared mini-UI */
  .ui-panel { padding: .85rem .95rem; border-radius: 18px; background: rgba(255, 251, 246, .9); border: 1px solid rgba(255, 255, 255, .95); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); box-shadow: 0 16px 36px rgba(60, 36, 24, .16), 0 2px 6px rgba(60, 36, 24, .06); font-size: .76rem; color: var(--ink-soft); }
  .ui-top { display: flex; align-items: center; gap: .45rem; font-weight: 700; font-size: .78rem; color: var(--ink); margin-bottom: .6rem; }
  .ui-top em { margin-left: auto; font-style: normal; font-weight: 600; font-size: .68rem; color: var(--ink-mute); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #4E7A45; box-shadow: 0 0 0 3px rgba(78, 122, 69, .16); }
  .dot.warm { background: var(--gold); box-shadow: 0 0 0 3px rgba(201, 169, 97, .2); }
  .bub { max-width: 86%; padding: .45rem .7rem; border-radius: 14px; line-height: 1.35; margin-bottom: .35rem; font-size: .76rem; }
  .bub.in { background: #EFE7DE; color: var(--ink); border-bottom-left-radius: 4px; }
  .bub.out { margin-left: auto; background: linear-gradient(135deg, var(--coral), var(--coral-deep)); color: #fff; border-bottom-right-radius: 4px; }
  .ui-foot { margin-top: .6rem; padding-top: .55rem; border-top: 1px solid rgba(92, 74, 63, .1); font-weight: 650; font-size: .72rem; color: var(--ink); }
  .ui-foot.split { display: flex; align-items: center; justify-content: space-between; gap: .6rem; flex-wrap: wrap; }
  .swap { display: inline-grid; }
  .swap > span { grid-area: 1 / 1; transition: opacity .5s ease, transform .6s cubic-bezier(.22, 1, .36, 1); }
  .swap > .a { opacity: 0; transform: translateY(-6px); }
  .swap > .b { opacity: 1; transform: none; }
  .ui-checks { list-style: none; margin: 0; padding: 0; display: grid; gap: .1rem; }
  .ui-checks li { display: flex; align-items: center; justify-content: space-between; gap: .6rem; padding: .3rem 0; border-top: 1px solid rgba(92, 74, 63, .07); font-weight: 550; color: var(--ink); }
  .ui-checks li:first-child { border-top: 0; }
  .ui-checks i { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 6px; background: #4E7A45; color: #fff; transition: transform .5s cubic-bezier(.22, 1, .36, 1), opacity .35s ease, background-color .4s ease; }
  .ui-checks svg, .ui-lock svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .step { transition: opacity .55s ease, transform .65s cubic-bezier(.22, 1, .36, 1); }

  /* 01 arrival */
  .s-arrival .vs-front { position: absolute; left: .9rem; right: .9rem; bottom: .9rem; display: grid; gap: .5rem; justify-items: start; }
  .ui-chip { display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .7rem .4rem .4rem; border-radius: 999px; background: rgba(255, 251, 246, .92); box-shadow: 0 10px 24px rgba(60, 36, 24, .2); font-size: .72rem; font-weight: 700; color: var(--ink); }
  .ui-chip em { font-style: normal; font-weight: 600; color: var(--ink-mute); padding-left: .45rem; border-left: 1px solid rgba(92, 74, 63, .15); }
  .ui-lock .ico > span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--ink); color: #fff; }
  .ui-lock .ico > .b { background: #4E7A45; }
  .ui-lock .ico svg { stroke-width: 2.4; }
  .ui-thread { width: min(100%, 360px); }
  .ui-stars { display: flex; align-items: center; justify-content: space-between; margin-top: .25rem; padding-top: .45rem; border-top: 1px solid rgba(92, 74, 63, .1); font-size: .68rem; font-weight: 600; color: var(--ink-mute); }
  .ui-stars b { display: inline-flex; gap: 1px; font-size: .8rem; color: var(--gold); }
  .ui-stars i { font-style: normal; display: inline-block; transition: opacity .4s ease var(--s), transform .5s cubic-bezier(.22, 1, .36, 1) var(--s); }

  /* 02 quality · 03 pricing — photo back plane grows to fill the row, panel overlaps its lower edge */
  .c2 .vs-scene, .c3 .vs-scene { flex: 1; display: flex; flex-direction: column; }
  .c2 .vs-photo.short, .c3 .vs-photo.short { flex: 1; aspect-ratio: auto; min-height: 130px; }
  .s-quality .vs-front, .s-pricing .vs-front { margin: -3.2rem .6rem 0; }
  .ring { width: 22px; height: 22px; transform: rotate(-90deg); flex: none; }
  .ring circle { fill: none; stroke-width: 4; }
  .ring .track { stroke: #EFE7DE; }
  .ring .fill { stroke: #4E7A45; stroke-linecap: round; stroke-dasharray: 95; stroke-dashoffset: 0; transition: stroke-dashoffset 2s cubic-bezier(.4, 0, .2, 1) .3s; }
  .state { margin-left: auto; font-size: .66rem; font-weight: 700; }
  .state .a { color: var(--ink-mute); } .state .b { color: #4E7A45; }

  /* 03 pricing */
  .tag { margin-left: auto; padding: .15rem .45rem; border-radius: 999px; background: #F3EAE1; font-size: .62rem; font-weight: 650; color: var(--ink-mute); letter-spacing: .01em; }
  .spark { position: relative; height: 60px; margin: .2rem 0 .5rem; }
  .spark svg { width: 100%; height: 100%; overflow: visible; }
  .spark .area { fill: rgba(255, 140, 114, .12); transition: opacity .8s ease .6s; }
  .spark .line { fill: none; stroke: var(--coral-deep); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 1.1s cubic-bezier(.4, 0, .2, 1) .2s; vector-effect: non-scaling-stroke; }
  .demand { position: absolute; right: 0; top: -.3rem; padding: .18rem .5rem; border-radius: 999px; background: #fff; box-shadow: 0 6px 14px rgba(60, 36, 24, .12); font-size: .64rem; font-weight: 700; color: var(--coral-ink); }
  .rates { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
  .rate { display: grid; justify-items: center; gap: .1rem; padding: .4rem 0; border-radius: 10px; background: #F6EFE8; transition: background-color .6s ease; font-variant-numeric: tabular-nums; }
  .rate .day { font-size: .58rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-mute); }
  .rate .val { font-size: .7rem; font-weight: 700; color: var(--ink); }
  .rate.up { background: #FFE3DA; }
  .rate.up .val .b { color: var(--coral-ink); }
  .rate.up .swap > span { transition-delay: var(--d); }
  .chips { display: flex; flex-wrap: wrap; gap: .25rem; }
  .chips i { font-style: normal; padding: .15rem .4rem; border-radius: 999px; background: #F3EAE1; font-size: .6rem; font-weight: 600; color: var(--ink-mute); }
  .done { font-size: .68rem; color: #4E7A45; }

  /* 04 care */
  .s-care { display: grid; }
  .s-care .vs-photo { grid-area: 1 / 1; aspect-ratio: auto; min-height: 100%; }
  .s-care .vs-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(42, 31, 26, .05), rgba(42, 31, 26, .35)); }
  .s-care .vs-front { grid-area: 1 / 1; margin: 1rem; align-self: end; }
  .ui-checks.compact li { padding: .22rem 0; }
  .resolved { display: inline-flex; margin-top: .5rem; padding: .25rem .6rem; border-radius: 999px; font-size: .68rem; font-weight: 700; background: #4E7A45; color: #fff; transition: background-color .7s ease, color .7s ease; }

  /* 05 owner update */
  .thumb { width: 36px; height: 36px; border-radius: 10px; overflow: hidden; flex: none; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ttl { display: grid; line-height: 1.2; }
  .ttl small { font-size: .64rem; font-weight: 600; color: var(--ink-mute); }
  .ui-timeline { position: relative; list-style: none; margin: .2rem 0 0; padding: 0 0 0 1.1rem; display: grid; gap: .45rem; }
  .rail { position: absolute; left: 4px; top: 6px; bottom: 6px; width: 2px; border-radius: 2px; background: linear-gradient(180deg, var(--coral), #4E7A45); transform-origin: top; transform: scaleY(1); transition: transform 1.7s cubic-bezier(.4, 0, .2, 1) .2s; }
  .ui-timeline li { position: relative; display: grid; grid-template-columns: 4.1rem 1fr; gap: .4rem; font-weight: 550; color: var(--ink); }
  .ui-timeline li::before { content: ''; position: absolute; left: calc(-1.1rem + 1px); top: .3rem; width: 8px; height: 8px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 2px var(--coral-deep); }
  .ui-timeline li:last-child::before { box-shadow: 0 0 0 2px #4E7A45; background: #4E7A45; }
  .ui-timeline time { font-size: .66rem; font-weight: 700; color: var(--ink-mute); font-variant-numeric: tabular-nums; }
  .note { font-family: var(--serif); font-style: italic; font-size: .92rem; font-weight: 600; color: var(--ink); }
  .more { font-size: .68rem; font-weight: 700; color: var(--coral-ink); }

  /* Wide cards: copy left, scene right */
  .wide .vs-card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: stretch; gap: clamp(1.2rem, 2.4vw, 2rem); }
  .wide .vs-copy { align-self: center; }
  .wide .vs-scene { margin-top: 0; }
  .c1 .vs-scene { flex: 1; display: flex; }
  .c1 .vs-photo { flex: 1; aspect-ratio: auto; min-height: 290px; }

  /* Pre-play states (only with JS + motion allowed); final states are the defaults above */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .vs-card:not(.is-playing) .step { opacity: 0; transform: translate3d(0, 8px, 0); }
    :global(.js) .vs-card:not(.is-playing) .swap > .a { opacity: 1; transform: none; }
    :global(.js) .vs-card:not(.is-playing) .swap > .b { opacity: 0; transform: translateY(6px); }
    :global(.js) .vs-card:not(.is-playing) .ui-checks i { opacity: 0; transform: scale(.4); }
    :global(.js) .vs-card:not(.is-playing) .ui-stars i { opacity: 0; transform: scale(.4); }
    :global(.js) .vs-card:not(.is-playing) .vs-index { transform: translateZ(20px) scale(.9); }
    :global(.js) .vs-card:not(.is-playing) .vs-index circle { stroke-dashoffset: 164; }
    :global(.js) .vs-card:not(.is-playing) .ring .fill { stroke-dashoffset: 95; }
    :global(.js) .vs-card:not(.is-playing) .spark .line { stroke-dashoffset: 1; }
    :global(.js) .vs-card:not(.is-playing) .spark .area { opacity: 0; }
    :global(.js) .vs-card:not(.is-playing) .rate.up { background: #F6EFE8; }
    :global(.js) .vs-card:not(.is-playing) .rail { transform: scaleY(0); }
    :global(.js) .vs-card:not(.is-playing) .resolved { background: #EFE7DE; color: var(--ink-mute); }
    :global(.js) .vs-card:not(.is-playing) .vs-photo { transform: translate3d(0, 5px, 0) scale(.98); }
    .vs-card.is-playing .step, .vs-card.is-playing .ui-checks li i { transition-delay: var(--d, 0ms); }
    .vs-card.is-playing .ui-checks li i { transition-delay: calc(var(--d, 0ms) + 120ms); }
    .vs-card.is-playing .s-arrival .swap > span { transition-delay: 450ms; }
    .vs-card.is-playing .s-quality .state > span { transition-delay: 2250ms; }
    .vs-card.is-playing .rate.up { transition-delay: var(--d); }
    .vs-card.is-playing .resolved { transition-delay: var(--d); }
  }

  /* Join strip */
  .vs-join { position: relative; overflow: hidden; margin-top: clamp(1.6rem, 3vw, 2.4rem); display: flex; align-items: center; gap: 1.5rem 2.5rem; padding: 1.6rem clamp(1.4rem, 3vw, 2.4rem); padding-right: clamp(1.4rem, 24vw, 340px); border-radius: 28px; background: rgba(255, 255, 255, .5); border: 1px solid rgba(255, 255, 255, .8); box-shadow: 0 1px 0 rgba(255, 255, 255, .9) inset, 0 14px 34px rgba(112, 70, 48, .08); }
  .vs-join-copy { flex: 1; min-width: 0; }
  .vs-join h3 { margin: .35rem 0 .35rem; font-size: clamp(1.35rem, 2vw, 1.65rem); }
  .vs-join p { margin: 0; max-width: 58ch; font-size: 1rem; color: var(--ink-soft); }
  .vs-join .btn { flex: none; position: relative; z-index: 1; }
  .vs-join-img { position: absolute; top: 0; right: 0; bottom: 0; width: min(24vw, 320px); -webkit-mask-image: linear-gradient(90deg, transparent, #000 70%); mask-image: linear-gradient(90deg, transparent, #000 70%); opacity: .55; filter: blur(2px) saturate(.9); }
