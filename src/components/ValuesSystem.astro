  @media (max-width: 1180px) {
    .vs-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .c1, .wide { grid-column: span 6; } .c2, .c3 { grid-column: span 3; }
    .c1 .vs-card { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 2rem; }
    .c1 .vs-copy { align-self: center; }
    .c1 .vs-photo { min-height: 300px; }
  }
  @media (max-width: 860px) {
    .vs-grid { grid-template-columns: minmax(0, 1fr); }
