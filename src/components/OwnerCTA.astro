---
import Icon from './Icon.astro';
import { u } from '../lib/url';
import { links } from '../data/business';
interface Props { title?: string; text?: string; }
const {
  title = 'Own the Property. <em>Let Us Handle the Hosting.</em>',
  text = 'Start with the property intake. Then schedule your property analysis tour when you are ready.',
} = Astro.props;
---
<section class="section-tight">
  <div class="container">
    <div class="cta-band bg-dark reveal">
      <div class="ghost-panels" aria-hidden="true"><span></span><span></span><span></span></div>
      <div style="position:relative">
        <span class="eyebrow">Property analysis tour</span>
        <h2 set:html={title} />
        <p class="lead">{text}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={u('/property-analysis/')} data-track="owner_analysis_start">See If You Qualify <Icon name="arrow" /></a>
          <a class="btn btn-glass" href={links.calendlyAnalysisTour} target="_blank" rel="noopener noreferrer" data-track="calendly_click">Book a Property Analysis Tour</a>
        </div>
      </div>
    </div>
  </div>
</section>
