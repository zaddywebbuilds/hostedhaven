---
import Icon from './Icon.astro';
import { u } from '../lib/url';
import { links } from '../data/business';
interface Props { title?: string; tourFirst?: boolean; }
const { title = 'Own the Property. <em>Let Us Handle the Hosting.</em>', tourFirst = false } = Astro.props;
const intake = { href: u('/property-intake/'), label: 'Submit Your Property Details', external: false, track: 'owner_analysis_start' };
const tour = { href: links.calendlyAnalysisTour, label: 'Book a Property Analysis Tour', external: true, track: 'calendly_click' };
const [lead, follow] = tourFirst ? [tour, intake] : [intake, tour];
---
<section class="section-tight">
  <div class="container">
    <div class="cta-band bg-dark reveal">
      <div class="ghost-panels" aria-hidden="true"><span></span><span></span><span></span></div>
      <div style="position:relative">
        <span class="eyebrow">Property analysis tour</span>
        <h2 set:html={title} />
        <div class="btn-row">
          <a class="btn btn-primary" href={lead.href} target={lead.external ? '_blank' : undefined} rel={lead.external ? 'noopener noreferrer' : undefined} data-track={lead.track}>{lead.label} <Icon name="arrow" /></a>
          <a class="btn btn-glass" href={follow.href} target={follow.external ? '_blank' : undefined} rel={follow.external ? 'noopener noreferrer' : undefined} data-track={follow.track}>{follow.label}</a>
        </div>
      </div>
    </div>
  </div>
</section>
