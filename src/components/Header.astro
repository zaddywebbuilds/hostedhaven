---
import Icon from './Icon.astro';
import { u } from '../lib/url';
import { business, links } from '../data/business';
const path = Astro.url.pathname;
const ownerLinks = [
  { href: '/airbnb-management-san-antonio/', label: 'Airbnb Management' },
  { href: '/airbnb-co-host-san-antonio/', label: 'STR Co-Hosting' },
  { href: '/mid-term-rental-management-san-antonio/', label: 'Mid-Term Rentals' },
  { href: '/airbnb-listing-optimization-san-antonio/', label: 'Listing Optimization' },
  { href: '/airbnb-revenue-management-san-antonio/', label: 'Revenue Management' },
  { href: '/str-property-care-san-antonio/', label: 'Property Care' },
  { href: '/airbnb-setup-san-antonio/', label: 'New Host Setup' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/results/', label: 'Results' },
  { href: links.serviceVideo, label: 'Service Video' },
];
const staysLinks = [
  { href: '/stays/', label: 'Browse All Stays' },
  { href: '/monthly-rentals-san-antonio/', label: 'Monthly Stays' },
  { href: '/pet-friendly-vacation-rentals-san-antonio/', label: 'Pet-Friendly' },
  { href: '/furnished-rentals-near-randolph-afb/', label: 'Near Randolph AFB' },
];
const isOn = (p: string) => (path.endsWith(p) ? 'page' : undefined);
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="hh-header" id="hh-header">
  <div class="hh-header-inner">
    <a class="hh-logo" href={u('/')} aria-label={`${business.shortName} home`}>
      <img src={u('/images/brand/hosted-havens-logo-stacked-320.webp')} alt="Hosted Havens" width="77" height="46" />
    </a>
    <nav class="hh-nav" aria-label="Main">
      <div class="nav-drop" data-drop>
        <button type="button" aria-expanded="false" aria-controls="owners-menu">Owners <Icon name="chevron" /></button>
        <div class="nav-menu" id="owners-menu">
          {ownerLinks.map((l) => (
            l.href.startsWith('http')
              ? <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
              : <a href={u(l.href)} aria-current={isOn(l.href)}>{l.label}</a>
          ))}
        </div>
      </div>
      <div class="nav-drop" data-drop>
        <button type="button" aria-expanded="false" aria-controls="stays-menu">Stays <Icon name="chevron" /></button>
        <div class="nav-menu" id="stays-menu">
          {staysLinks.map((l) => (
            <a href={u(l.href)} aria-current={isOn(l.href)}>{l.label}</a>
          ))}
        </div>
      </div>
      <a href={u('/about/')} aria-current={isOn('/about/')}>About</a>
      <a href={u('/resources/')} aria-current={isOn('/resources/')} class="hide-lg">Resources</a>
      <a href={u('/contact/')} aria-current={isOn('/contact/')} class="hide-lg">Contact</a>
    </nav>
    <div class="hh-actions">
      <a class="hh-guest-link" href={u('/property-analysis/')} data-track="owner_analysis_start">Property Intake</a>
      <a class="btn btn-primary btn-sm" href={u('/stays/')} data-track="stays_view">Book a Stay</a>
      <button class="hh-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer" data-drawer-open>
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true" data-drawer>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer-top">
      <img src={u('/images/brand/hosted-havens-logo-stacked-320.webp')} alt="Hosted Havens" width="74" height="44" />
      <button class="drawer-close" type="button" aria-label="Close menu" data-drawer-close><Icon name="close" /></button>
    </div>
    <div class="drawer-group">
      <h2>Own a property?</h2>
      {ownerLinks.map((l) => (
        l.href.startsWith('http')
          ? <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}<Icon name="arrow" class="small" /></a>
          : <a href={u(l.href)}>{l.label}<Icon name="arrow" class="small" /></a>
      ))}
    </div>
    <div class="drawer-group">
      <h2>Need a stay?</h2>
      <a href={u('/stays/')}>Browse Stays <Icon name="arrow" /></a>
      <a href={u('/why-book-direct/')}>Why Book Direct <Icon name="arrow" /></a>
      <a href={u('/monthly-rentals-san-antonio/')}>Monthly Stays <Icon name="arrow" /></a>
    </div>
    <div class="drawer-group">
      <h2>Company</h2>
      <a href={u('/results/')}>Results <Icon name="arrow" /></a>
      <a href={u('/about/')}>About <Icon name="arrow" /></a>
      <a href={u('/resources/')}>Owner Resources <Icon name="arrow" /></a>
      <a href={u('/contact/')}>Contact <Icon name="arrow" /></a>
    </div>
    <div class="drawer-cta">
      <a class="btn btn-primary" href={u('/property-analysis/')} data-track="owner_analysis_start">See If You Qualify</a>
      <a class="btn btn-glass" href={`tel:${business.phone}`} data-track="phone_click">Call {business.displayPhone}</a>
    </div>
  </div>
</div>
