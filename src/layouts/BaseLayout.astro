---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { canonical, u, SITE } from '../lib/url';
import { coverImage } from '../lib/images';
import { business, analytics, socials, guestReviews } from '../data/business';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  schema?: object[];
  noindex?: boolean;
  breadcrumbs?: Crumb[];
}
const { title, description, path, ogImage = '/images/og/hosted-havens-og.jpg', schema = [], noindex = false, breadcrumbs } = Astro.props;
const canon = canonical(path);
const ogAbs = `${SITE}${ogImage}`;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE}/#organization`,
  name: business.name,
  alternateName: business.shortName,
  url: `${SITE}/`,
  logo: `${SITE}/images/brand/hosted-havens-logo-stacked-640.webp`,
  email: business.ownerEmail,
  telephone: business.phone,
  founder: { '@type': 'Person', name: business.founder },
  areaServed: business.serviceArea.map((c) => ({ '@type': 'City', name: `${c}, TX` })),
  sameAs: socials.map((s) => s.href),
};
const crumbSchema = breadcrumbs?.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: canonical(c.path) })),
    }]
  : [];
const allSchema = [org, ...crumbSchema, ...schema];

const guestPage = /^\/(stays|why-book-direct|monthly-rentals|pet-friendly|furnished-rentals)/.test(path);
const quietPage = /^\/(property-analysis|privacy|terms|404)/.test(path);
const toastImg = coverImage(guestPage ? 'coastal-run' : 'de-soto-lighthouse');
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canon} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#E5664A" />
  <meta name="geo.region" content="US-TX" />
  <meta name="geo.placename" content="San Antonio" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={business.shortName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canon} />
  <meta property="og:image" content={ogAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogAbs} />
  {analytics.googleSiteVerification && <meta name="google-site-verification" content={analytics.googleSiteVerification} />}
  {analytics.bingSiteVerification && <meta name="msvalidate.01" content={analytics.bingSiteVerification} />}

  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="icon" href={u('/favicon-32.png')} sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600;700&family=Allura&display=swap" />

  {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

  <script is:inline>document.documentElement.classList.add('js');</script>
  {analytics.ga4Id && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4Id}`}></script>
      <script is:inline define:vars={{ id: analytics.ga4Id }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('js',new Date());gtag('config',id);</script>
    </>
  )}
  <slot name="head" />
</head>
<body>
  <div class="announce">
    <span class="pulse" aria-hidden="true"></span>
    {guestPage
      ? <>Book direct with Hosted Havens — local support, no third-party platform fees.<a href={u('/why-book-direct/')}>Why book direct →</a></>
      : <>Now welcoming new San Antonio property owners.<a href={u('/property-analysis/')} data-track="owner_analysis_start">Get a free property analysis →</a></>}
  </div>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />

  {!quietPage && (
    <>
      <aside class="toast left" data-toast-reviews data-reviews={JSON.stringify(guestReviews.map((r) => ({ ...r, avatar: r.avatar ? u(`/images/${r.avatar}-192.webp`) : '' })))} aria-label="Guest review" aria-live="polite">
        <button type="button" class="toast-close" data-toast-close aria-label="Dismiss guest reviews"><Icon name="close" /></button>
        <div class="toast-head">
          <img class="toast-avatar" data-r-avatar alt="" width="40" height="40" hidden />
          <span class="avatar-initial" data-r-initial></span>
          <div><strong data-r-name></strong><span class="stars" aria-label="5 out of 5 stars">★★★★★</span> <span class="meta" data-r-from></span></div>
        </div>
        <p data-r-quote></p>
        <span class="toast-source"><span class="live"></span>Verified guest review</span>
      </aside>
      <aside class="toast right" data-toast-cta aria-label={guestPage ? 'Book direct' : 'Free property analysis'}>
        <button type="button" class="toast-close" data-toast-close aria-label="Dismiss"><Icon name="close" /></button>
        <div class="toast-head">
          {toastImg && <img class="toast-img" src={u(`/images/${toastImg.base}-640.webp`)} alt="" width="54" height="54" loading="lazy" />}
          <div>
            <strong>{guestPage ? 'Planning a San Antonio stay?' : 'Own a San Antonio rental?'}</strong>
            <span class="meta">{guestPage ? 'Book direct for local support and no platform fees.' : 'See what pricing, presentation and hands-off hosting could change.'}</span>
          </div>
        </div>
        {guestPage
          ? <a class="toast-cta" href={u('/stays/')} data-track="stays_view">Browse stays <Icon name="arrow" /></a>
          : <a class="toast-cta" href={u('/property-analysis/')} data-track="owner_analysis_start">Get my free analysis <Icon name="arrow" /></a>}
      </aside>
    </>
  )}

  <script>
    const header = document.getElementById('hh-header');
    const bar = document.querySelector('[data-mobile-bar]');
    const onScroll = () => {
      const y = window.scrollY;
      header?.classList.toggle('is-scrolled', y > 24);
      bar?.classList.toggle('show', y > 420);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    document.querySelectorAll<HTMLElement>('[data-drop]').forEach((drop) => {
      const btn = drop.querySelector('button');
      btn?.addEventListener('click', () => {
        const open = drop.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', (e) => {
        if (!drop.contains(e.target as Node)) { drop.classList.remove('open'); btn?.setAttribute('aria-expanded', 'false'); }
      });
    });

    const drawer = document.querySelector<HTMLElement>('[data-drawer]');
    const opener = document.querySelector<HTMLElement>('[data-drawer-open]');
    const setDrawer = (open: boolean) => {
      drawer?.classList.toggle('open', open);
      drawer?.setAttribute('aria-hidden', String(!open));
      opener?.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) drawer?.querySelector<HTMLElement>('[data-drawer-close]')?.focus(); else opener?.focus();
    };
    opener?.addEventListener('click', () => setDrawer(true));
    drawer?.querySelector('[data-drawer-close]')?.addEventListener('click', () => setDrawer(false));
    drawer?.addEventListener('click', (e) => { if (e.target === drawer) setDrawer(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (drawer?.classList.contains('open')) setDrawer(false);
        document.querySelectorAll('[data-drop].open').forEach((d) => d.classList.remove('open'));
      }
    });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reveals = document.querySelectorAll('.reveal');
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -5% 0px', threshold: 0 });
      reveals.forEach((el) => io.observe(el));
      // Safety net: never leave content hidden if an observer callback is missed.
      window.setTimeout(() => document.documentElement.classList.add('reveal-ready'), 2500);
    } else {
      reveals.forEach((el) => el.classList.add('in'));
    }

    if (!reduce && window.matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((scene) => {
        const target = scene.querySelector<HTMLElement>('[data-tilt-target]');
        if (!target) return;
        scene.addEventListener('pointermove', (e) => {
          const r = scene.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          target.style.setProperty('--tx', `${x * 10}deg`);
          target.style.setProperty('--ty', `${-y * 8}deg`);
        });
        scene.addEventListener('pointerleave', () => { target.style.removeProperty('--tx'); target.style.removeProperty('--ty'); });
      });
    }

    const seen = (k: string) => { try { return sessionStorage.getItem(k) === '1'; } catch { return false; } };
    const remember = (k: string) => { try { sessionStorage.setItem(k, '1'); } catch { /* storage unavailable */ } };

    const reviewToast = document.querySelector<HTMLElement>('[data-toast-reviews]');
    if (reviewToast && !seen('hh-reviews-closed')) {
      type Review = { quote: string; name: string; from: string; avatar?: string };
      const reviews: Review[] = JSON.parse(reviewToast.dataset.reviews || '[]');
      let i = 0;
      let paused = false;
      let timer = 0;
      const fill = (r: Review) => {
        const avatar = reviewToast.querySelector<HTMLImageElement>('[data-r-avatar]')!;
        const initial = reviewToast.querySelector<HTMLElement>('[data-r-initial]')!;
        avatar.hidden = !r.avatar;
        initial.hidden = Boolean(r.avatar);
        if (r.avatar) avatar.src = r.avatar;
        initial.textContent = r.name.charAt(0);
        reviewToast.querySelector('[data-r-name]')!.textContent = r.name;
        reviewToast.querySelector('[data-r-from]')!.textContent = r.from;
        reviewToast.querySelector('[data-r-quote]')!.textContent = `“${r.quote}”`;
      };
      const next = () => {
        if (paused || !reviews.length) return;
        reviewToast.classList.remove('show');
        window.setTimeout(() => { fill(reviews[i++ % reviews.length]); reviewToast.classList.add('show'); }, 550);
      };
      window.setTimeout(() => {
        if (!reviews.length) return;
        fill(reviews[i++]);
        reviewToast.classList.add('show');
        timer = window.setInterval(next, 9000);
      }, 4000);
      reviewToast.addEventListener('mouseenter', () => { paused = true; });
      reviewToast.addEventListener('mouseleave', () => { paused = false; });
      reviewToast.querySelector('[data-toast-close]')?.addEventListener('click', () => {
        window.clearInterval(timer);
        reviewToast.classList.remove('show');
        remember('hh-reviews-closed');
      });
    }

    const ctaToast = document.querySelector<HTMLElement>('[data-toast-cta]');
    if (ctaToast && !seen('hh-cta-closed')) {
      let shown = false;
      const reveal = () => { if (shown) return; shown = true; ctaToast.classList.add('show'); window.removeEventListener('scroll', onDepth); };
      const onDepth = () => { if (window.scrollY > window.innerHeight * 1.4) reveal(); };
      window.addEventListener('scroll', onDepth, { passive: true });
      window.setTimeout(reveal, 15000);
      ctaToast.querySelector('[data-toast-close]')?.addEventListener('click', () => {
        ctaToast.classList.remove('show');
        remember('hh-cta-closed');
      });
    }

    // Tuck the floating widgets while a dense content section fills the middle of the screen.
    const safeZones = document.querySelectorAll('[data-toast-safe]');
    if (safeZones.length && 'IntersectionObserver' in window) {
      const active = new Set<Element>();
      const tuck = new IntersectionObserver((entries) => {
        entries.forEach((en) => (en.isIntersecting ? active.add(en.target) : active.delete(en.target)));
        document.documentElement.classList.toggle('toasts-tucked', active.size > 0);
      }, { rootMargin: '-35% 0px -35% 0px' });
      safeZones.forEach((z) => tuck.observe(z));
    }

    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((car) => {
      const track = car.querySelector<HTMLElement>('.car-track');
      const step = () => (track?.firstElementChild as HTMLElement | null)?.getBoundingClientRect().width ?? 320;
      car.querySelector('[data-car-prev]')?.addEventListener('click', () => track?.scrollBy({ left: -(step() + 24) }));
      car.querySelector('[data-car-next]')?.addEventListener('click', () => track?.scrollBy({ left: step() + 24 }));
    });

    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((wrap) => {
      const buttons = [...wrap.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      buttons.forEach((b) => b.addEventListener('click', () => {
        buttons.forEach((x) => {
          const on = x === b;
          x.setAttribute('aria-selected', String(on));
          x.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(x.getAttribute('aria-controls') || '');
          if (panel) panel.hidden = !on;
        });
      }));
    });

    document.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
      if (!el) return;
      const w = window as unknown as { gtag?: (...a: unknown[]) => void };
      w.gtag?.('event', el.dataset.track, { link_url: (el as HTMLAnchorElement).href || undefined, page_path: location.pathname });
    });
  </script>
</body>
</html>
